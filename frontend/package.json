{
  "name": "xiaoying-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.18 <23" },
  "scripts": {
    "dev": "node scripts/next.mjs dev --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs",
    "typecheck": "node scripts/next.mjs typegen && tsc --noEmit",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 0.0.0.0"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.2.0",
    "typescript": "^5.9.3"
  }
}
